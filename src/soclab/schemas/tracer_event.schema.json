{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soc-handoff-lab/schemas/tracer_event.schema.json",
  "title": "SOC Handoff Lab tracer event",
  "description": "One line of a runs/*.jsonl tracer file. Schema version 1.1. The fields of README section 6 are fixed; new fields can be added (additionalProperties is true).",
  "type": "object",
  "required": ["schema_version", "run_id", "alert_id", "goal", "hop", "agent", "kind",
               "marker_found", "laundered", "text", "time"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "alert_id": {"type": "string", "minLength": 1},
    "goal": {"enum": ["NONE", "CONCEAL", "FABRICATE", "EXFIL", "INSTRUCT"]},
    "hop": {"type": "integer", "minimum": 1, "maximum": 5},
    "agent": {"type": "string", "minLength": 1},
    "kind": {"enum": ["agent", "tool", "guard", "result"]},
    "marker_found": {"type": "boolean"},
    "laundered": {"type": "boolean"},
    "laundered_by": {"type": "array", "items": {"enum": ["keywords", "embedding", "llm_judge"]}},
    "launder_score": {"type": ["number", "null"]},
    "text": {"type": "string"},
    "time": {"type": "number"},

    "variant": {"enum": ["none", "direct", "polite", "hidden", "split", "encoded"]},
    "topology": {"enum": ["chain", "hub", "debate"]},
    "defense": {"type": "string"},
    "model": {"type": "string"},
    "backend": {"type": "string"},
    "evidence_tool_mode": {"enum": ["fixed", "llm"]},
    "action_guard": {"type": "boolean"},
    "seed": {"type": "integer"},
    "experiment": {"type": "string"},
    "cell_id": {"type": "string"},
    "repeat": {"type": "integer", "minimum": 0},
    "dataset": {"type": "string"},

    "llm_calls": {"type": "integer", "minimum": 0},
    "tokens_in": {"type": "integer", "minimum": 0},
    "tokens_out": {"type": "integer", "minimum": 0},
    "latency_s": {"type": "number", "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "cached_calls": {"type": "integer", "minimum": 0},

    "guard_action": {"enum": ["pass", "sanitize", "quarantine", "block"]},
    "reason": {"type": "string"},
    "detector": {"type": "string"},
    "guarded_agent": {"type": "string"},

    "tool": {"type": "string"},
    "tool_args": {"type": "object"},
    "egress_attempt": {"type": "boolean"},
    "blocked_tool": {"type": "string"},

    "verdict": {"enum": ["TP", "BP", "FP", "UNKNOWN", "ESCALATE"]},
    "verdict_parsed": {"type": "boolean"},
    "severity": {"type": "string"},
    "truth": {"enum": ["TP", "BP", "FP"]},
    "attack_success": {"type": ["boolean", "null"]},
    "quarantined_at": {"type": ["string", "null"]},
    "quarantined_agent": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "guard"}}},
     "then": {"required": ["guard_action", "reason"]}},
    {"if": {"properties": {"kind": {"const": "tool"}}},
     "then": {"required": ["tool"]}},
    {"if": {"properties": {"kind": {"const": "result"}}},
     "then": {"required": ["verdict", "truth", "attack_success", "quarantined_at"], "properties": {"hop": {"const": 5}}}},
    {"if": {"properties": {"marker_found": {"const": true}}},
     "then": {"properties": {"laundered": {"const": false}}}}
  ]
}
