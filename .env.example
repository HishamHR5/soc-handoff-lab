# Copy this file to .env and fill in only the keys that you use.
#   cp .env.example .env
# .env is in .gitignore. Never commit it. Never put keys in settings.yaml or in code.

# backend: anthropic   (Claude, for example claude-sonnet-5-5 or claude-haiku-5-5)
ANTHROPIC_API_KEY=

# backend: openai
OPENAI_API_KEY=

# backend: gemini
GEMINI_API_KEY=

# backend: openai_compat (Ollama, vLLM, LM Studio). Most local servers accept any text.
OPENAI_COMPAT_API_KEY=
